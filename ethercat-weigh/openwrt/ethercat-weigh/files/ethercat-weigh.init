#!/bin/sh /etc/rc.common
# procd-Init-Script for ethercat-weigh
# to show logs: logread -e ethercat-weigh

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/ethercat-weigh
CONF=/etc/ethercat-weigh/config.json

start_service() {
	procd_open_instance
	# Log output via syslog with priority per level (daemon.info/warn/err).
	procd_set_param command "$PROG" -c "$CONF" --syslog
	# respawn {threshold seconds} {timeout seconds} {retry count}
	procd_set_param respawn 3600 5 0
	# Only unexpected output (e.g. abort messages of the runtime) ends up on stderr
	# and is logged by procd as daemon.err.
	procd_set_param stderr 1
	procd_close_instance
}
