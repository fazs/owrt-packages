#!/bin/sh /etc/rc.common
# procd-Init-Script for ethercat-weigh
# to show logs: logread -e ethercat-weigh

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/ethercat-weigh
CONF=/etc/ethercat-weigh/config.json

start_service() {
	procd_open_instance
	# Logausgabe per syslog mit Priorität je Level (daemon.info/warn/err).
	procd_set_param command "$PROG" -c "$CONF" --syslog
	# respawn {threshold seconds} {timeout seconds} {retry count}
	procd_set_param respawn 3600 5 0
	# Nur unerwartete Ausgaben (z. B. Abbruchmeldungen der Laufzeitumgebung) landen auf stderr
	# und werden von procd als daemon.err protokolliert.
	procd_set_param stderr 1
	procd_close_instance
}
