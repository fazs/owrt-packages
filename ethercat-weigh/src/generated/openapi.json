    "/api/debug/sdo": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "index": {
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "op": {
                    "enum": [
                      "read",
                      "write"
                    ],
                    "type": "string"
                  },
                  "sub": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "enum": [
                      "bool",
                      "u8",
                      "u16",
                      "u32",
                      "u64",
                      "i8",
                      "i16",
                      "i32",
                      "f32"
                    ],
                    "type": "string"
                  },
                  "value": {
                    "type": [
                      "number",
                      "boolean"
                    ]
                  }
                },
                "required": [
                  "op",
                  "index",
                  "sub",
                  "type"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "hex": {
                      "type": "string"
                    },
                    "ok": {
                      "type": "boolean"
                    },
                    "value": {
                      "type": [
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            },
            "description": "Ungültige Anfrage"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "hex": {
                      "type": "string"
                    },
                    "ok": {
                      "type": "boolean"
                    },
                    "value": {
                      "type": [
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Im aktuellen Zustand nicht ausführbar"
          }
        },
        "summary": "Einzelner SDO-Zugriff",
        "tags": [
          "Debug"
        ]
