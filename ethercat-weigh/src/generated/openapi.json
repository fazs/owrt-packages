                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            },
            "description": "Im aktuellen Zustand nicht ausführbar"
          }
        },
        "summary": "Steuerbit 0x7000 übersteuern; value null hebt auf, clear hebt alle auf",
        "tags": [
          "Debug"
        ]
      }
    },
