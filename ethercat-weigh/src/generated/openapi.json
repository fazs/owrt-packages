  "info": {
    "description": "REST-API von ethercat-weigh. Ereignisse (sample, measurement, config, ...) kommen über den WebSocket /ws; die erste Nachricht nach dem Verbindungsaufbau ist {\"type\": \"init\", \"snapshot\", \"config\"}.",
    "title": "ethercat-weigh",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/calibration": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "index": {
                    "type": "integer"
                  },
                  "mass": {
                    "type": "number"
                  },
                  "nominal_load": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string"
                  }
                },
                "required": [
                  "action"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            },
            "description": "Ungültige Anfrage"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            },
            "description": "Im aktuellen Zustand nicht ausführbar"
          }
        },
        "summary": "Kalibrierschritt ausführen (Aktionen siehe README)",
        "tags": [
          "Kalibrierung"
        ]
      }
    },
    "/api/config": {
      "get": {
        "responses": {
