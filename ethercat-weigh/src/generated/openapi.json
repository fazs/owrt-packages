          "Debug"
        ]
      }
    },
    "/api/debug/override": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "clear": {
                    "type": "boolean"
                  },
                  "sub": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "value": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
