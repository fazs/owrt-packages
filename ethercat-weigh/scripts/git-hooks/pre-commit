#!/bin/sh
# Increment PKG_RELEASE of ethercat-weigh if the commit touches ethercat-weigh/.
# The changed Makefile is added to the same commit.
# Skip: EW_NO_BUMP=1 git commit ...
set -eu

[ -z "${EW_NO_BUMP:-}" ] || exit 0
git_dir=$(git rev-parse --git-dir)
# Not during rebase/cherry-pick/merge
[ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ] || \
  [ -f "$git_dir/CHERRY_PICK_HEAD" ] || [ -f "$git_dir/MERGE_HEAD" ] && exit 0
git diff --cached --quiet -- ethercat-weigh/ && exit 0

mk=ethercat-weigh/openwrt/ethercat-weigh/Makefile
# Unstaged changes to the Makefile would otherwise end up in the commit
if ! git diff --quiet -- "$mk"; then
  echo "pre-commit: $mk hat nicht gestagete Änderungen; bitte stagen oder EW_NO_BUMP=1 setzen" >&2
  exit 1
fi

old=$(sed -n 's/^PKG_RELEASE:=//p' "$mk")
new=$((old + 1))
sed -i "s/^PKG_RELEASE:=.*/PKG_RELEASE:=$new/" "$mk"
git add "$mk"
echo "pre-commit: ethercat-weigh PKG_RELEASE $old -> $new"

# Marker for post-commit: build and deploy after this commit
touch "$git_dir/ew-deploy-pending"
