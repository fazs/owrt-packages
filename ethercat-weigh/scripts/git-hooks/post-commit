#!/bin/sh
# After a commit with a release bump (pre-commit), build and deploy to the target device.
# Skip: EW_NO_DEPLOY=1 git commit ...
# Output additionally goes to .git/ew-deploy.log; a failure does not undo the commit.

git_dir=$(git rev-parse --git-dir)
marker=$git_dir/ew-deploy-pending
[ -f "$marker" ] || exit 0
rm -f "$marker"
[ -z "${EW_NO_DEPLOY:-}" ] || exit 0

deploy=$(git rev-parse --show-toplevel)/ethercat-weigh/scripts/deploy.sh
log=$git_dir/ew-deploy.log
# With a terminal: stdin from /dev/tty so that ssh/scp can ask for passphrase/host key.
# Without a terminal (IDE): batch-mode behavior via </dev/null.
if (: </dev/tty) 2>/dev/null; then in=/dev/tty; else in=/dev/null; fi
{ "$deploy" <"$in" 2>&1; echo $? >"$log.rc"; } | tee "$log"
rc=$(cat "$log.rc"); rm -f "$log.rc"
[ "$rc" = 0 ] || echo "post-commit: Deploy fehlgeschlagen (Exit $rc), siehe $log" >&2
exit 0
