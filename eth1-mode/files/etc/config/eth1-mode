# Konfiguration für /usr/sbin/eth1-mode
# eth0 wird von diesem Mechanismus nicht referenziert.

config eth1mode 'main'
	# Modus bei aktivem Schalter (ACTION=pressed) [lan | wan]; inaktiv ergibt den jeweils anderen Modus
	option pressed_mode 'lan'

	# Label des Schalters in /sys/kernel/debug/gpio (Abgleich beim Boot)
	option switch_label 'mode'
	# Name des Bridge-Device
	option bridge 'br-lan'

	# Logisches Interface für eth1 im WAN-Modus
	option wan_iface 'wan'

	# Wireless-Client (wifi-iface, mode=sta), im LAN-Modus aktiv als Uplink
	option sta_section 'wifinet3'
