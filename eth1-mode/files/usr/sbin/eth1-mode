#!/bin/sh
# Umschaltung eth1 zwischen WAN und LAN
#   wan: eth1 einziger WAN-Port (DHCP-Client), Wireless-Client deaktiviert
#   lan: eth1 Port von br-lan, Wireless-Client aktiv als Uplink
# Logausgabe: logread -e eth1-mode

. /lib/functions.sh

PORT=eth1
LOCK=/var/lock/eth1-mode.lock

log() {
	logger -t eth1-mode "$*"
	echo "$*" >&2
}

usage() {
	cat >&2 <<-USAGE
	Usage: eth1-mode <wan|lan|status|sync|switch <0|1>> [--no-reload]
	  wan        eth1 als WAN, Wireless-Client aus
	  lan        eth1 in Bridge, Wireless-Client als Uplink
	  status     aktuellen Modus und Schalterzustand ausgeben
	  sync       Modus aus Schalterzustand (debugfs) übernehmen
	  switch N   Modus aus logischem Schalterzustand N übernehmen (rc.button)
	USAGE
	exit 1
}

load_config() {
	config_load eth1-mode
	config_get PRESSED_MODE main pressed_mode lan
	config_get SWITCH_LABEL main switch_label mode
	config_get BRIDGE main bridge br-lan
	config_get WAN_IFACE main wan_iface wan
	config_get STA_SECTION main sta_section wifinet3
}

# UCI-Sektion des Bridge-Device ermitteln (config device, option name)
bridge_section() {
	uci -q show network | sed -n "s/^network\.\([^.]*\)\.name='$BRIDGE'$/\1/p" | head -n1
}

# Logischer Schalterzustand (1 = aktiv) aus debugfs, leer bei Fehler
switch_state() {
	local line raw
	line=$(grep -m1 "|$SWITCH_LABEL " /sys/kernel/debug/gpio 2>/dev/null) || return 1
	case "$line" in
		*" hi"*) raw=1 ;;
		*" lo"*) raw=0 ;;
		*) return 1 ;;
	esac
	case "$line" in
		*"ACTIVE LOW"*) raw=$((1 - raw)) ;;
	esac
	echo "$raw"
}

state_to_mode() {
	if [ "$1" = 1 ]; then
		echo "$PRESSED_MODE"
	elif [ "$PRESSED_MODE" = lan ]; then
		echo wan
	else
		echo lan
	fi
}

current_mode() {
	[ "$(uci -q get network.$WAN_IFACE.device)" = "$PORT" ] && echo wan || echo lan
}

# Wireless-Client aktivieren (0) bzw. deaktivieren (1)
set_sta_disabled() {
	if [ "$(uci -q get wireless.$STA_SECTION.mode)" != sta ]; then
		log "WARN: wifi-iface '$STA_SECTION' with mode=sta not found"
		return 1
	fi
	uci set wireless.$STA_SECTION.disabled="$1"
}

# wan6 an das logische WAN-Interface binden (keine Referenz auf eth0)
fix_wan6() {
	[ -n "$(uci -q get network.wan6)" ] && uci set network.wan6.device="@$WAN_IFACE"
}

apply_wan() {
	local br="$1"
	case " $(uci -q get network.$br.ports) " in
		*" $PORT "*) uci del_list network.$br.ports="$PORT" ;;
	esac
	uci set network.$WAN_IFACE=interface
	uci set network.$WAN_IFACE.device="$PORT"
	uci set network.$WAN_IFACE.proto=dhcp
	fix_wan6
	set_sta_disabled 1
}

apply_lan() {
	local br="$1"
	case " $(uci -q get network.$br.ports) " in
		*" $PORT "*) ;;
		*) uci add_list network.$br.ports="$PORT" ;;
	esac
	uci set network.$WAN_IFACE=interface
	uci -q delete network.$WAN_IFACE.device
	uci set network.$WAN_IFACE.proto=dhcp
	fix_wan6
	set_sta_disabled 0
}

set_mode() {
	local mode="$1" reload="$2" br

	br=$(bridge_section)
	if [ -z "$br" ]; then
		log "Fehler: Bridge-Device '$BRIDGE' nicht gefunden"
		return 1
	fi

	case "$mode" in
		wan) apply_wan "$br" ;;
		lan) apply_lan "$br" ;;
	esac

	if [ -z "$(uci changes network; uci changes wireless)" ]; then
		log "eth1 bereits im Modus $mode"
		return 0
	fi

	uci commit network
	uci commit wireless
	log "eth1 auf Modus $mode umgeschaltet"

	if [ "$reload" = 1 ]; then
		/etc/init.d/network reload
		wifi reload
	fi
}

print_status() {
	local state
	state=$(switch_state)
	echo "mode:   $(current_mode)"
	echo "switch: ${state:-unbekannt}${state:+ ($(state_to_mode "$state"))}"
	if [ "$(uci -q get wireless.$STA_SECTION.disabled)" = 1 ]; then
		echo "sta:    $STA_SECTION disabled"
	else
		echo "sta:    $STA_SECTION enabled"
	fi
}

cmd="$1"
shift
reload=1
case "$1 $2" in
	*--no-reload*) reload=0 ;;
esac

load_config

case "$cmd" in
	wan|lan)
		mode="$cmd"
		;;
	switch)
		case "$1" in
			0|1) mode=$(state_to_mode "$1") ;;
			*) usage ;;
		esac
		;;
	sync)
		state=$(switch_state) || {
			log "Schalterzustand nicht lesbar, Konfiguration unverändert"
			exit 0
		}
		mode=$(state_to_mode "$state")
		;;
	status)
		print_status
		exit 0
		;;
	*)
		usage
		;;
esac

lock "$LOCK"
set_mode "$mode" "$reload"
rc=$?
lock -u "$LOCK"
exit $rc
